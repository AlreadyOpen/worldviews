{
  "name": "worldviews",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:full": "PUBLIC_EDITION=full rsbuild dev --port 8761",
    "build": "PUBLIC_EDITION=libre rsbuild build",
    "build:full": "PUBLIC_EDITION=full rsbuild build",
    "deploy": "npm run build && wrangler pages deploy dist-libre/client --project-name worldviews-libre",
    "deploy:full": "npm run build:full && wrangler pages deploy dist-full/client --project-name worldviews"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@iconify-icons/ph": "2.0.0",
    "@iconify-icons/tabler": "2.0.1",
    "@mapbox/vector-tile": "3.0.0",
    "@rsbuild/core": "2.2.11",
    "@rsbuild/plugin-react": "2.1.1",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "iconify-icon": "3.0.3",
    "maplibre-gl": "6.13.0",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satellite.js": "7.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  },
  "license": "Apache-2.0"
}
